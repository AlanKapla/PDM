# Skill: UI / Hooki

## Opis
Tworzenie custom hooków do fetchowania danych, mutacji i zarządzania stanem.
Projekt używa **TanStack React Query 5** jako głównego wzorca fetch/mutacji.

## Kiedy używać
Użyj tego skilla gdy tworzysz lub modyfikujesz hook (use*.ts).

---

## Lokalizacja

```
src/hooks/use{Feature}{Action}.ts     ← hooki globalne
src/features/{domain}/hooks/          ← hooki domenowe
```

## Hook fetch — React Query (preferowany wzorzec)

```typescript
// src/features/dashboard/hooks/useProjectDashboard.ts
import { useQuery } from '@tanstack/react-query';
import type { ProjectDashboardWeb } from '../types/projectDashboard.types';
import { dashboardApi } from '../services/dashboardApi';

export function useProjectDashboard(tenantId: string, projectId: string) {
    return useQuery({
        queryKey: ['projectDashboard', tenantId, projectId],
        queryFn: () => dashboardApi.getProjectDashboard(tenantId, projectId),
        enabled: !!tenantId && !!projectId,
    });
}

// Użycie w komponencie:
// const { data, isLoading, error, refetch } = useProjectDashboard(tenantId, projectId);
```

## Hook mutacji — React Query (preferowany wzorzec)

```typescript
// src/hooks/useCreateProject.ts
import { useMutation, useQueryClient } from '@tanstack/react-query';
import type { CreateProjectRequest, ProjectDetailsWeb } from '../types/project.types';
import { projectApi } from '../api/projectApi';

export function useCreateProject(tenantId: string) {
    const queryClient = useQueryClient();

    return useMutation({
        mutationFn: (data: CreateProjectRequest): Promise<ProjectDetailsWeb> =>
            projectApi.create(tenantId, data),
        onSuccess: () => {
            queryClient.invalidateQueries({ queryKey: ['projects', tenantId] });
        },
    });
}

// Użycie w komponencie:
// const { mutateAsync: createProject, isPending, error } = useCreateProject(tenantId);
```

