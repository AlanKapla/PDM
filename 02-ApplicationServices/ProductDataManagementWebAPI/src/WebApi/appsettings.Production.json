{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "Issuer": "ProductDataManagementWebAPI",
    "Audience": "ProductDataManagementWebAPI",
    "ExpiryMinutes": 15
  },
  "EmailSettings": {
    "Provider": "SendGrid",
    "SendGrid": {
      "DefaultFromName": "BrickSoft"
    }
  }
}
